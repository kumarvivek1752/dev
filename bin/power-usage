#!/usr/bin/env bash
# ==============================================================================
# power-usage: Comprehensive Laptop Power Consumption & Telemetry Monitor
# Measures and breaks down wattage across CPU, GPU, Display, Fans, Battery & Platform.
# ==============================================================================

set -u

# --- ANSI Styling ---
if [[ -t 1 ]]; then
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    RED=$'\033[1;31m'
    GREEN=$'\033[1;32m'
    YELLOW=$'\033[1;33m'
    BLUE=$'\033[1;34m'
    MAGENTA=$'\033[1;35m'
    CYAN=$'\033[1;36m'
    WHITE=$'\033[1;37m'
    RESET=$'\033[0m'
else
    BOLD=""
    DIM=""
    RED=""
    GREEN=""
    YELLOW=""
    BLUE=""
    MAGENTA=""
    CYAN=""
    WHITE=""
    RESET=""
fi

# --- Default Options ---
WATCH_MODE=false
INTERVAL=1.0
OUTPUT_JSON=false
OUTPUT_WAYBAR=false

# --- Parse Arguments ---
print_help() {
    cat << EOF
${BOLD}power-usage${RESET} - Comprehensive Laptop Power & Wattage Monitor

${BOLD}USAGE:${RESET}
    power-usage [OPTIONS]
    sudo power-usage [OPTIONS]   (Recommended: enables direct Intel RAPL hardware counters)

${BOLD}OPTIONS:${RESET}
    -w, --watch [INTERVAL]   Continuous live refresh mode (default: 1.0s, press 'q' or Ctrl+C to exit)
    -1, --once               Single snapshot mode (default)
    -j, --json               Output raw telemetry formatted as JSON
    -b, --waybar             Output compact JSON formatted for Waybar custom module
    -h, --help               Display this help message

${BOLD}HARDWARE COVERAGE:${RESET}
    * ${CYAN}Battery & AC Mains${RESET}   : Charge/Discharge rates, Voltage, Health, Battery wear & Cycle count
    * ${CYAN}CPU Subsystem${RESET}        : Intel RAPL Package, Cores & Uncore Watts, PL1/PL2 Limits, Thermals, Clock MHz
    * ${CYAN}GPU Subsystem${RESET}        : NVIDIA RTX 4060 Instantaneous Power Draw, Limits, VRAM, Clocks & Thermals
    * ${CYAN}Display Backlight${RESET}    : Screen brightness level, Backlight percentage & estimated display draw
    * ${CYAN}Cooling Fans${RESET}         : Acer Dual-Fan RPMs (CPU Fan & GPU Fan) & estimated fan draw
    * ${CYAN}Platform / Peripherals${RESET}: NVMe SSD, DDR5 RAM, Intel Wi-Fi 6 & Motherboard baseline
    * ${CYAN}Process Insights${RESET}     : Top power-consuming CPU processes & active GPU compute/graphics apps

${BOLD}NOTE ON PRIVILEGES:${RESET}
    Intel RAPL hardware energy counters (/sys/class/powercap/intel-rapl) require root
    privileges (CVE-2020-8694 Platypus kernel mitigation).
    When run as a regular user, CPU power is estimated from utilization & TDP.
    For 100% exact hardware-measured CPU Watts, run with: ${BOLD}sudo power-usage${RESET}
EOF
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -w|--watch)
            WATCH_MODE=true
            if [[ $# -gt 1 && "$2" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
                INTERVAL="$2"
                shift
            fi
            shift
            ;;
        -1|--once)
            WATCH_MODE=false
            shift
            ;;
        -j|--json)
            OUTPUT_JSON=true
            shift
            ;;
        -b|--waybar)
            OUTPUT_WAYBAR=true
            shift
            ;;
        -h|--help)
            print_help
            ;;
        *)
            echo "Unknown option: $1"
            echo "Run 'power-usage --help' for usage."
            exit 1
            ;;
    esac
done

# --- Dynamic Hardware Sensor Discovery ---
discover_sensors() {
    # Power Supply (Battery & AC)
    AC_DIR=""
    for ac in /sys/class/power_supply/AC* /sys/class/power_supply/ADP*; do
        if [[ -d "$ac" ]]; then AC_DIR="$ac"; break; fi
    done

    BAT_DIR=""
    for bat in /sys/class/power_supply/BAT*; do
        if [[ -d "$bat" ]]; then BAT_DIR="$bat"; break; fi
    done

    # Display Backlight
    BACKLIGHT_DIR=""
    for bl in /sys/class/backlight/*; do
        if [[ -d "$bl" ]]; then BACKLIGHT_DIR="$bl"; break; fi
    done

    # Hwmon Device Nodes
    HWMON_CPU=""
    HWMON_ACER=""
    HWMON_NVME=""
    HWMON_WIFI=""
    HWMON_RAM=()

    for h in /sys/class/hwmon/hwmon*; do
        if [[ -d "$h" ]]; then
            local hname
            hname=$(cat "$h/name" 2>/dev/null || echo "")
            case "$hname" in
                coretemp|k10temp|cpu_thermal) HWMON_CPU="$h" ;;
                acer*) HWMON_ACER="$h" ;;
                nvme*) [[ -z "$HWMON_NVME" ]] && HWMON_NVME="$h" ;;
                iwlwifi*|ath*|rtw*) HWMON_WIFI="$h" ;;
                spd5118*|ee1004*) HWMON_RAM+=("$h") ;;
            esac
        fi
    done

    # CPU RAPL Domain Nodes
    RAPL_PKG=""
    RAPL_CORE=""
    RAPL_UNCORE=""
    RAPL_READABLE=false

    for r in /sys/class/powercap/intel-rapl:*; do
        if [[ -d "$r" ]]; then
            local rname
            rname=$(cat "$r/name" 2>/dev/null || echo "")
            case "$rname" in
                package-*) RAPL_PKG="$r" ;;
                core)      RAPL_CORE="$r" ;;
                uncore)    RAPL_UNCORE="$r" ;;
            esac
        fi
    done

    if [[ -n "$RAPL_PKG" && -r "$RAPL_PKG/energy_uj" ]]; then
        RAPL_READABLE=true
    fi
}

discover_sensors

# Helper: Draw visual ASCII gauge
draw_bar() {
    local val="${1:-0}"
    local max="${2:-100}"
    local width="${3:-16}"
    local color="${4:-$CYAN}"

    local pct
    pct=$(awk -v v="$val" -v m="$max" 'BEGIN { if (m<=0) m=1; p=int((v*100)/m); if (p<0) p=0; if (p>100) p=100; print p }')
    local filled=$(( (pct * width) / 100 ))
    local empty=$(( width - filled ))

    local bar=""
    for ((i=0; i<filled; i++)); do bar+="█"; done
    for ((i=0; i<empty; i++)); do bar+="░"; done

    printf "%b[%s]%b" "$color" "$bar" "$RESET"
}

# --- Collect Power & System Metrics ---
sample_telemetry() {
    local sample_dt="$INTERVAL"
    # For single run or fast watch, sample delta
    local dt_sleep=0.6
    if (( $(awk -v s="$sample_dt" 'BEGIN {print (s < 0.6)}') )); then
        dt_sleep="$sample_dt"
    fi

    # 1. AC & Battery Status
    AC_ONLINE=0
    [[ -n "$AC_DIR" && -r "$AC_DIR/online" ]] && AC_ONLINE=$(cat "$AC_DIR/online" 2>/dev/null || echo 0)

    BAT_STATUS="Unknown"
    BAT_CAPACITY=0
    BAT_VOLTAGE_V=0
    BAT_CURRENT_A=0
    BAT_POWER_W=0
    BAT_CHARGE_NOW_WH=0
    BAT_CHARGE_FULL_WH=0
    BAT_CHARGE_DESIGN_WH=0
    BAT_HEALTH_PCT=100
    BAT_CYCLES=0

    if [[ -n "$BAT_DIR" && -d "$BAT_DIR" ]]; then
        BAT_STATUS=$(cat "$BAT_DIR/status" 2>/dev/null || echo "Unknown")
        BAT_CAPACITY=$(cat "$BAT_DIR/capacity" 2>/dev/null || echo 0)
        local v_raw i_raw c_now c_full c_des cycles
        v_raw=$(cat "$BAT_DIR/voltage_now" 2>/dev/null || echo 0)
        i_raw=$(cat "$BAT_DIR/current_now" 2>/dev/null || echo 0)
        c_now=$(cat "$BAT_DIR/charge_now" 2>/dev/null || echo 0)
        c_full=$(cat "$BAT_DIR/charge_full" 2>/dev/null || echo 0)
        c_des=$(cat "$BAT_DIR/charge_full_design" 2>/dev/null || echo 0)
        cycles=$(cat "$BAT_DIR/cycle_count" 2>/dev/null || echo 0)

        BAT_VOLTAGE_V=$(awk -v v="$v_raw" 'BEGIN { printf "%.3f", v / 1000000 }')
        BAT_CURRENT_A=$(awk -v i="$i_raw" 'BEGIN { printf "%.3f", i / 1000000 }')
        BAT_POWER_W=$(awk -v v="$v_raw" -v i="$i_raw" 'BEGIN { printf "%.2f", (v * i) / 1000000000000 }')
        BAT_CYCLES="$cycles"

        # Energy Wh = (Charge µAh * Voltage µV) / 10^12
        BAT_CHARGE_NOW_WH=$(awk -v c="$c_now" -v v="$v_raw" 'BEGIN { printf "%.2f", (c * v) / 1000000000000 }')
        BAT_CHARGE_FULL_WH=$(awk -v c="$c_full" -v v="$v_raw" 'BEGIN { printf "%.2f", (c * v) / 1000000000000 }')
        BAT_CHARGE_DESIGN_WH=$(awk -v c="$c_des" -v v="$v_raw" 'BEGIN { printf "%.2f", (c * v) / 1000000000000 }')
        if (( c_des > 0 )); then
            BAT_HEALTH_PCT=$(awk -v cf="$c_full" -v cd="$c_des" 'BEGIN { printf "%.1f", (cf * 100.0) / cd }')
        fi
    fi

    # 2. Start Sampling CPU & RAPL Counters
    local t1_ns t2_ns delta_ns
    local pkg_e1=0 pkg_e2=0 core_e1=0 core_e2=0 uncore_e1=0 uncore_e2=0
    local pkg_max_uj=262143328850 core_max_uj=262143328850 uncore_max_uj=262143328850

    local u1 n1 s1 i1 io1 ir1 sir1 st1
    local u2 n2 s2 i2 io2 ir2 sir2 st2

    read -r _ u1 n1 s1 i1 io1 ir1 sir1 st1 _ < /proc/stat
    local total1=$((u1 + n1 + s1 + i1 + io1 + ir1 + sir1 + st1))
    local idle1=$((i1 + io1))

    if [[ "$RAPL_READABLE" == true ]]; then
        t1_ns=$(date +%s%N)
        pkg_e1=$(cat "$RAPL_PKG/energy_uj" 2>/dev/null || echo 0)
        [[ -n "$RAPL_CORE" ]] && core_e1=$(cat "$RAPL_CORE/energy_uj" 2>/dev/null || echo 0)
        [[ -n "$RAPL_UNCORE" ]] && uncore_e1=$(cat "$RAPL_UNCORE/energy_uj" 2>/dev/null || echo 0)
        [[ -r "$RAPL_PKG/max_energy_range_uj" ]] && pkg_max_uj=$(cat "$RAPL_PKG/max_energy_range_uj" 2>/dev/null || echo 262143328850)
    fi

    # Sampling window
    sleep "$dt_sleep"

    # End of sampling
    read -r _ u2 n2 s2 i2 io2 ir2 sir2 st2 _ < /proc/stat
    local total2=$((u2 + n2 + s2 + i2 + io2 + ir2 + sir2 + st2))
    local idle2=$((i2 + io2))

    local diff_total=$((total2 - total1))
    local diff_idle=$((idle2 - idle1))
    CPU_USAGE_PCT="0.0"
    if (( diff_total > 0 )); then
        CPU_USAGE_PCT=$(awk -v t="$diff_total" -v i="$diff_idle" 'BEGIN { printf "%.1f", ((t - i) * 100.0) / t }')
    fi

    # CPU Frequency & Governor
    CPU_AVG_MHZ=$(awk '/cpu MHz/ {sum+=$4; count++} END {if (count>0) printf "%.0f", sum/count; else print "0"}' /proc/cpuinfo)
    CPU_THREADS=$(nproc 2>/dev/null || echo 1)
    CPU_MODEL=$(awk -F: '/model name/ {gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2; exit}' /proc/cpuinfo)
    CPU_GOVERNOR=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "default")

    # CPU Power Calculation
    CPU_PKG_W="0.00"
    CPU_CORE_W="0.00"
    CPU_UNCORE_W="0.00"
    CPU_POWER_ESTIMATED=false

    if [[ "$RAPL_READABLE" == true ]]; then
        t2_ns=$(date +%s%N)
        pkg_e2=$(cat "$RAPL_PKG/energy_uj" 2>/dev/null || echo 0)
        [[ -n "$RAPL_CORE" ]] && core_e2=$(cat "$RAPL_CORE/energy_uj" 2>/dev/null || echo 0)
        [[ -n "$RAPL_UNCORE" ]] && uncore_e2=$(cat "$RAPL_UNCORE/energy_uj" 2>/dev/null || echo 0)

        delta_ns=$((t2_ns - t1_ns))
        if (( delta_ns > 0 )); then
            calc_rapl_watts() {
                local e1="$1" e2="$2" max_r="$3" d_ns="$4"
                awk -v e1="$e1" -v e2="$e2" -v max="$max_r" -v dns="$d_ns" 'BEGIN {
                    delta_e = e2 - e1;
                    if (delta_e < 0 && max > 0) delta_e += max;
                    if (dns > 0) printf "%.2f", (delta_e * 1000.0) / dns;
                    else print "0.00";
                }'
            }
            CPU_PKG_W=$(calc_rapl_watts "$pkg_e1" "$pkg_e2" "$pkg_max_uj" "$delta_ns")
            CPU_CORE_W=$(calc_rapl_watts "$core_e1" "$core_e2" "$core_max_uj" "$delta_ns")
            CPU_UNCORE_W=$(calc_rapl_watts "$uncore_e1" "$uncore_e2" "$uncore_max_uj" "$delta_ns")
        fi
    else
        # Estimation based on utilization, clock frequency, and TDP
        CPU_POWER_ESTIMATED=true
        CPU_PKG_W=$(awk -v util="$CPU_USAGE_PCT" -v mhz="$CPU_AVG_MHZ" 'BEGIN {
            # Base idle draw ~7W, Base active TDP 55W, Turbo scaling
            idle_w = 7.0;
            active_tdp = 55.0;
            base_mhz = 2100.0;
            ratio = mhz / base_mhz;
            if (ratio < 0.5) ratio = 0.5;
            if (ratio > 2.5) ratio = 2.5;
            p = idle_w + (util / 100.0) * (active_tdp - idle_w) * ratio;
            printf "%.2f", p;
        }')
        CPU_CORE_W=$(awk -v pkg="$CPU_PKG_W" 'BEGIN { printf "%.2f", pkg * 0.65 }')
        CPU_UNCORE_W=$(awk -v pkg="$CPU_PKG_W" 'BEGIN { printf "%.2f", pkg * 0.35 }')
    fi

    # CPU Power Limits (PL1 / PL2)
    CPU_PL1_W="N/A"
    CPU_PL2_W="N/A"
    if [[ -n "$RAPL_PKG" ]]; then
        local pl1_uw pl2_uw
        pl1_uw=$(cat "$RAPL_PKG/constraint_0_power_limit_uw" 2>/dev/null || echo 0)
        pl2_uw=$(cat "$RAPL_PKG/constraint_1_power_limit_uw" 2>/dev/null || echo 0)
        (( pl1_uw > 0 )) && CPU_PL1_W=$(awk -v uw="$pl1_uw" 'BEGIN { printf "%.0f W", uw / 1000000 }')
        (( pl2_uw > 0 )) && CPU_PL2_W=$(awk -v uw="$pl2_uw" 'BEGIN { printf "%.0f W", uw / 1000000 }')
    fi

    # CPU Thermals
    CPU_PKG_TEMP="N/A"
    CPU_MAX_TEMP="N/A"
    if [[ -n "$HWMON_CPU" ]]; then
        # Read Package and hottest core
        local temps_info
        temps_info=$(awk '
            /Package id 0/ { pkg=$NF }
            /Core / { val=+$NF; if (val>max) max=val }
            END { print (pkg ? pkg : "N/A") "," (max ? "+" max "°C" : "N/A") }
        ' <(for f in "$HWMON_CPU"/temp*_label; do
            [[ -r "$f" ]] || continue
            label=$(cat "$f" 2>/dev/null)
            input_file="${f%_label}_input"
            val=$(cat "$input_file" 2>/dev/null)
            if [[ -n "$val" ]]; then
                echo "$label: +$((val / 1000))°C"
            fi
        done))
        CPU_PKG_TEMP=$(echo "$temps_info" | cut -d',' -f1)
        CPU_MAX_TEMP=$(echo "$temps_info" | cut -d',' -f2)
    fi

    # 3. Dedicated GPU (NVIDIA RTX 4060)
    GPU_NAME="NVIDIA GPU"
    GPU_POWER_W="0.00"
    GPU_POWER_LIMIT_W="N/A"
    GPU_UTIL_PCT="0"
    GPU_MEM_UTIL_PCT="0"
    GPU_TEMP_C="N/A"
    GPU_GR_CLOCK_MHZ="0"
    GPU_MEM_CLOCK_MHZ="0"
    GPU_PSTATE="N/A"
    GPU_VRAM_USED_MIB="0"
    GPU_VRAM_TOTAL_MIB="0"
    GPU_AVAILABLE=false

    if command -v nvidia-smi >/dev/null 2>&1; then
        GPU_AVAILABLE=true
        # Parse Instantaneous Power Draw reliably with sanity checking (rejecting 590W glitch & transient 0W)
        local nvsmi_pwr=""
        for _attempt in 1 2; do
            local parsed_try
            parsed_try=$(nvidia-smi -q -d POWER 2>/dev/null | awk -F: '
                /Instantaneous Power Draw/ && !inst { split($2, a, " "); inst = a[1]; }
                /Average Power Draw/ && !avg { split($2, a, " "); avg = a[1]; }
                /Current Power Limit/ && !limit { split($2, a, " "); limit = a[1]; }
                END {
                    pwr = "0.00";
                    n_inst = inst + 0;
                    n_avg = avg + 0;
                    if (inst ~ /^[0-9.]+/ && n_inst <= 140 && n_inst > 0) {
                        pwr = sprintf("%.2f", n_inst);
                    } else if (avg ~ /^[0-9.]+/ && n_avg <= 140 && n_avg > 0) {
                        pwr = sprintf("%.2f", n_avg);
                    } else if (n_inst == 0 && inst ~ /^[0-9.]+/) {
                        pwr = "0.00";
                    }
                    print pwr "," (limit ? limit : "N/A") "," (n_inst > 140 ? "GLITCH" : "OK");
                }')
            local cur_pwr cur_limit cur_stat
            cur_pwr=$(echo "$parsed_try" | cut -d',' -f1)
            cur_limit=$(echo "$parsed_try" | cut -d',' -f2)
            cur_stat=$(echo "$parsed_try" | cut -d',' -f3)

            nvsmi_pwr="${cur_pwr},${cur_limit}"
            if [[ "$cur_stat" != "GLITCH" && "$cur_pwr" != "0.00" ]]; then
                break
            fi
            sleep 0.08
        done

        GPU_POWER_W=$(echo "$nvsmi_pwr" | cut -d',' -f1)
        GPU_POWER_LIMIT_W=$(echo "$nvsmi_pwr" | cut -d',' -f2)

        # Query GPU performance & utilization
        local nvsmi_stats
        nvsmi_stats=$(nvidia-smi --query-gpu=name,utilization.gpu,utilization.memory,temperature.gpu,clocks.gr,clocks.mem,pstate,memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null || echo "")
        if [[ -n "$nvsmi_stats" ]]; then
            IFS=',' read -r GPU_NAME GPU_UTIL_PCT GPU_MEM_UTIL_PCT GPU_TEMP_C GPU_GR_CLOCK_MHZ GPU_MEM_CLOCK_MHZ GPU_PSTATE GPU_VRAM_USED_MIB GPU_VRAM_TOTAL_MIB <<< "$nvsmi_stats"
            # Trim whitespace
            GPU_NAME=$(echo "$GPU_NAME" | xargs)
            GPU_UTIL_PCT=$(echo "$GPU_UTIL_PCT" | xargs)
            GPU_MEM_UTIL_PCT=$(echo "$GPU_MEM_UTIL_PCT" | xargs)
            GPU_TEMP_C=$(echo "$GPU_TEMP_C" | xargs)
            GPU_GR_CLOCK_MHZ=$(echo "$GPU_GR_CLOCK_MHZ" | xargs)
            GPU_MEM_CLOCK_MHZ=$(echo "$GPU_MEM_CLOCK_MHZ" | xargs)
            GPU_PSTATE=$(echo "$GPU_PSTATE" | xargs)
            GPU_VRAM_USED_MIB=$(echo "$GPU_VRAM_USED_MIB" | xargs)
            GPU_VRAM_TOTAL_MIB=$(echo "$GPU_VRAM_TOTAL_MIB" | xargs)
        fi
    fi

    # 4. Display Backlight & Estimated Power
    DISP_BRIGHTNESS=0
    DISP_MAX_BRIGHTNESS=1
    DISP_PCT=0
    DISP_POWER_W="0.00"
    if [[ -n "$BACKLIGHT_DIR" && -d "$BACKLIGHT_DIR" ]]; then
        DISP_BRIGHTNESS=$(cat "$BACKLIGHT_DIR/brightness" 2>/dev/null || echo 0)
        DISP_MAX_BRIGHTNESS=$(cat "$BACKLIGHT_DIR/max_brightness" 2>/dev/null || echo 1)
        (( DISP_MAX_BRIGHTNESS <= 0 )) && DISP_MAX_BRIGHTNESS=1
        DISP_PCT=$(( (DISP_BRIGHTNESS * 100) / DISP_MAX_BRIGHTNESS ))
        # Screen draw: 1.5W base panel logic + up to 4.5W LED backlight
        DISP_POWER_W=$(awk -v b="$DISP_BRIGHTNESS" -v m="$DISP_MAX_BRIGHTNESS" 'BEGIN { printf "%.2f", 1.50 + ((b / m) * 4.50) }')
    fi

    # 5. Cooling Fans & Estimated Power
    FAN_CPU_RPM=0
    FAN_GPU_RPM=0
    FAN_POWER_W="0.00"
    if [[ -n "$HWMON_ACER" && -d "$HWMON_ACER" ]]; then
        FAN_CPU_RPM=$(cat "$HWMON_ACER/fan1_input" 2>/dev/null || echo 0)
        FAN_GPU_RPM=$(cat "$HWMON_ACER/fan2_input" 2>/dev/null || echo 0)
        # Fan draw: ~0.2W baseline, scaling to ~2.5W each at max ~5000 RPM
        FAN_POWER_W=$(awk -v f1="$FAN_CPU_RPM" -v f2="$FAN_GPU_RPM" 'BEGIN {
            p1 = ((f1 / 5000.0) ^ 2) * 2.50;
            p2 = ((f2 / 5000.0) ^ 2) * 2.50;
            printf "%.2f", p1 + p2;
        }')
    fi

    # 6. Storage, Wi-Fi & Memory Peripherals
    NVME_TEMP_C="N/A"
    [[ -n "$HWMON_NVME" && -r "$HWMON_NVME/temp1_input" ]] && NVME_TEMP_C="$(( $(cat "$HWMON_NVME/temp1_input" 2>/dev/null || echo 0) / 1000 ))°C"

    WIFI_TEMP_C="N/A"
    [[ -n "$HWMON_WIFI" && -r "$HWMON_WIFI/temp1_input" ]] && WIFI_TEMP_C="$(( $(cat "$HWMON_WIFI/temp1_input" 2>/dev/null || echo 0) / 1000 ))°C"

    RAM_TEMP_C="N/A"
    if [[ ${#HWMON_RAM[@]} -gt 0 ]]; then
        local rtemps=()
        for rh in "${HWMON_RAM[@]}"; do
            local t_raw
            t_raw=$(cat "$rh/temp1_input" 2>/dev/null || echo "")
            [[ -n "$t_raw" ]] && rtemps+=("$((t_raw / 1000))°C")
        done
        [[ ${#rtemps[@]} -gt 0 ]] && RAM_TEMP_C=$(IFS='/'; echo "${rtemps[*]}")
    fi

    # Peripheral & Baseboard Platform Power Estimate
    # NVMe (~0.8W idle), Wi-Fi (~0.6W idle), 2x DDR5 RAM (~2.0W), Chipset/EC base (~3.0W) = ~6.4W
    PERIPH_BASE_W="6.40"

    # 7. Total System Consumption Aggregate
    # Subsystems Sum
    SUBSYSTEMS_SUM_W=$(awk -v cpu="$CPU_PKG_W" -v gpu="$GPU_POWER_W" -v disp="$DISP_POWER_W" -v fan="$FAN_POWER_W" -v base="$PERIPH_BASE_W" '
        BEGIN { printf "%.2f", cpu + gpu + disp + fan + base }')

    if [[ "$BAT_STATUS" == "Discharging" && $(awk -v p="$BAT_POWER_W" 'BEGIN {print (p > 0)}') -eq 1 ]]; then
        # On battery: battery fuel gauge provides the true total physical power draw
        TOTAL_SYSTEM_W="$BAT_POWER_W"
        TOTAL_POWER_MODE="Measured (Battery Discharge)"
    else
        # On AC mains: total power is the aggregated sum of all hardware subsystems
        TOTAL_SYSTEM_W="$SUBSYSTEMS_SUM_W"
        TOTAL_POWER_MODE="Aggregated (Subsystems Sum)"
    fi
}

# --- JSON Output Mode ---
output_json() {
    sample_telemetry
    cat << EOF
{
  "timestamp": "$(date -Iseconds)",
  "power_source": {
    "ac_online": $((AC_ONLINE)),
    "battery_status": "$BAT_STATUS",
    "battery_capacity_percent": $BAT_CAPACITY,
    "battery_voltage_v": $BAT_VOLTAGE_V,
    "battery_current_a": $BAT_CURRENT_A,
    "battery_rate_watts": $BAT_POWER_W,
    "battery_energy_now_wh": $BAT_CHARGE_NOW_WH,
    "battery_energy_full_wh": $BAT_CHARGE_FULL_WH,
    "battery_health_percent": $BAT_HEALTH_PCT,
    "battery_cycle_count": $BAT_CYCLES
  },
  "total_system_watts": $TOTAL_SYSTEM_W,
  "measurement_mode": "$TOTAL_POWER_MODE",
  "cpu": {
    "model": "$CPU_MODEL",
    "threads": $CPU_THREADS,
    "governor": "$CPU_GOVERNOR",
    "usage_percent": $CPU_USAGE_PCT,
    "avg_frequency_mhz": $CPU_AVG_MHZ,
    "package_watts": $CPU_PKG_W,
    "cores_watts": $CPU_CORE_W,
    "uncore_watts": $CPU_UNCORE_W,
    "is_estimated": $CPU_POWER_ESTIMATED,
    "pl1_limit": "$CPU_PL1_W",
    "pl2_limit": "$CPU_PL2_W",
    "package_temp": "$CPU_PKG_TEMP",
    "max_core_temp": "$CPU_MAX_TEMP"
  },
  "gpu": {
    "name": "$GPU_NAME",
    "watts": $GPU_POWER_W,
    "power_limit_watts": "$GPU_POWER_LIMIT_W",
    "utilization_percent": $GPU_UTIL_PCT,
    "memory_utilization_percent": $GPU_MEM_UTIL_PCT,
    "vram_used_mib": $GPU_VRAM_USED_MIB,
    "vram_total_mib": $GPU_VRAM_TOTAL_MIB,
    "graphics_clock_mhz": $GPU_GR_CLOCK_MHZ,
    "memory_clock_mhz": $GPU_MEM_CLOCK_MHZ,
    "temp_c": "$GPU_TEMP_C",
    "pstate": "$GPU_PSTATE"
  },
  "display": {
    "brightness": $DISP_BRIGHTNESS,
    "max_brightness": $DISP_MAX_BRIGHTNESS,
    "percent": $DISP_PCT,
    "estimated_watts": $DISP_POWER_W
  },
  "fans": {
    "cpu_fan_rpm": $FAN_CPU_RPM,
    "gpu_fan_rpm": $FAN_GPU_RPM,
    "estimated_watts": $FAN_POWER_W
  },
  "platform_peripherals": {
    "nvme_temp": "$NVME_TEMP_C",
    "wifi_temp": "$WIFI_TEMP_C",
    "ram_temp": "$RAM_TEMP_C",
    "estimated_watts": $PERIPH_BASE_W
  }
}
EOF
}

# --- Waybar Output Mode ---
output_waybar() {
    sample_telemetry
    local icon="⚡"
    local class="ac"
    if [[ "$BAT_STATUS" == "Discharging" ]]; then
        icon="🔋"
        class="discharging"
    elif [[ "$BAT_STATUS" == "Charging" ]]; then
        icon="🔌⚡"
        class="charging"
    fi

    # Query time-series database for today's aggregate energy if available
    local today_kwh=""
    local today_avg_w=""
    local db_file="$HOME/.local/share/power-usage/power.db"
    if [[ -r "$db_file" ]] && command -v sqlite3 >/dev/null 2>&1; then
        local agg
        agg=$(sqlite3 -batch -noheader "$db_file" "SELECT COALESCE(round(sum(total_w)/3600000.0, 3), 0.0), COALESCE(round(avg(total_w), 1), 0.0) FROM samples WHERE timestamp >= strftime('%s', 'now', 'start of day', 'localtime');" 2>/dev/null)
        if [[ -n "$agg" ]]; then
            today_kwh=$(echo "$agg" | cut -d'|' -f1)
            today_avg_w=$(echo "$agg" | cut -d'|' -f2)
        fi
    fi

    local text="${icon} ${TOTAL_SYSTEM_W}W"
    if [[ -n "$today_kwh" && "$today_kwh" != "0.0" && "$today_kwh" != "0" ]]; then
        text="${icon} ${TOTAL_SYSTEM_W}W (${today_kwh}kWh)"
    fi

    local tooltip="Total System Power: ${TOTAL_SYSTEM_W} W (${TOTAL_POWER_MODE})\\n"
    tooltip+="────────────────────────────────────────\\n"
    tooltip+="CPU:  ${CPU_PKG_W} W (${CPU_USAGE_PCT}% @ ${CPU_AVG_MHZ}MHz, ${CPU_PKG_TEMP})\\n"
    tooltip+="GPU:  ${GPU_POWER_W} W (${GPU_UTIL_PCT}%, ${GPU_TEMP_C}°C)\\n"
    tooltip+="Disp: ${DISP_POWER_W} W (${DISP_PCT}% Brightness)\\n"
    tooltip+="Fans: ${FAN_POWER_W} W (CPU:${FAN_CPU_RPM} GPU:${FAN_GPU_RPM} RPM)\\n"
    tooltip+="Base: ${PERIPH_BASE_W} W (RAM, SSD, Wi-Fi & Board)\\n"
    tooltip+="────────────────────────────────────────\\n"
    tooltip+="Power Source: $( [[ $AC_ONLINE -eq 1 ]] && echo 'AC Mains' || echo 'Battery' ) (${BAT_STATUS}, ${BAT_CAPACITY}%)\\n"
    if [[ -n "$today_kwh" && "$today_kwh" != "0.0" && "$today_kwh" != "0" ]]; then
        tooltip+="────────────────────────────────────────\\n"
        tooltip+="📊 Today's Aggregate: ${today_kwh} kWh (avg ${today_avg_w} W)\\n"
        tooltip+="Left-click: Desktop notification | Right-click: Full report"
    fi

    cat << EOF
{"text": "$text", "tooltip": "$tooltip", "class": "$class"}
EOF
}

# --- Terminal Dashboard Display Mode ---
render_dashboard() {
    sample_telemetry

    # Clear screen if in watch mode
    if [[ "$WATCH_MODE" == true ]]; then
        clear
    fi

    # Header Box
    local cur_time
    cur_time=$(date "+%Y-%m-%d %H:%M:%S")
    echo -e "${BOLD}${CYAN}╔════════════════════════════════════════════════════════════════════════════════╗${RESET}"
    echo -e "${BOLD}${CYAN}║${RESET} ${BOLD}${WHITE}LAPTOP POWER & ENERGY CONSUMPTION MONITOR${RESET}                    ${DIM}${cur_time}${RESET} ${BOLD}${CYAN}║${RESET}"
    echo -e "${BOLD}${CYAN}╚════════════════════════════════════════════════════════════════════════════════╝${RESET}"

    # Section 1: Power Source & Total Power
    local pwr_badge=""
    if [[ "$AC_ONLINE" -eq 1 ]]; then
        pwr_badge="${GREEN}[ 🔌 AC MAINS ONLINE ]${RESET}"
    else
        pwr_badge="${YELLOW}[ 🔋 ON BATTERY ]${RESET}"
    fi

    local bat_badge=""
    if [[ "$BAT_STATUS" == "Full" ]]; then
        bat_badge="${GREEN}Fully Charged (100%)${RESET}"
    elif [[ "$BAT_STATUS" == "Discharging" ]]; then
        bat_badge="${RED}Discharging (-${BAT_POWER_W} W)${RESET}"
    elif [[ "$BAT_STATUS" == "Charging" ]]; then
        bat_badge="${CYAN}Charging (+${BAT_POWER_W} W)${RESET}"
    else
        bat_badge="${WHITE}${BAT_STATUS} (${BAT_CAPACITY}%)${RESET}"
    fi

    echo -e "${BOLD}${MAGENTA}▶ SYSTEM POWER OVERVIEW${RESET}  ${pwr_badge}  ${bat_badge}"
    echo -e "  ${BOLD}Total Consumption:${RESET} ${BOLD}${YELLOW}${TOTAL_SYSTEM_W} Watts${RESET}  ${DIM}(${TOTAL_POWER_MODE})${RESET}"
    echo -e "  ${DIM}Battery Voltage  :${RESET} ${BAT_VOLTAGE_V} V  ${DIM}| Current:${RESET} ${BAT_CURRENT_A} A  ${DIM}| Capacity:${RESET} ${BAT_CAPACITY}% (${BAT_CHARGE_NOW_WH} / ${BAT_CHARGE_FULL_WH} Wh)"
    echo -e "  ${DIM}Battery Health   :${RESET} ${BAT_HEALTH_PCT}% (${BAT_CHARGE_FULL_WH} of ${BAT_CHARGE_DESIGN_WH} Wh design)  ${DIM}| Cycles:${RESET} ${BAT_CYCLES}"
    echo ""

    # Section 2: CPU Subsystem
    echo -e "${BOLD}${CYAN}▶ CPU SUBSYSTEM${RESET}  ${WHITE}${CPU_MODEL}${RESET}"
    if [[ "$CPU_POWER_ESTIMATED" == true ]]; then
        echo -e "  ${BOLD}Package Power   :${RESET} ${BOLD}${GREEN}${CPU_PKG_W} W${RESET} ${YELLOW}(Estimated)${RESET}  ${DIM}Covers: Cores ~${CPU_CORE_W} W | Uncore ~${CPU_UNCORE_W} W${RESET}"
        echo -e "  ${DIM}RAPL Notice     :${RESET} ${DIM}Intel RAPL requires root. Run with ${BOLD}sudo power-usage${RESET}${DIM} for direct hardware watts.${RESET}"
    else
        echo -e "  ${BOLD}Package Power   :${RESET} ${BOLD}${GREEN}${CPU_PKG_W} W${RESET} ${DIM}(Hardware RAPL)${RESET}"
        echo -e "  ${DIM}Power Breakdown :${RESET} ├── Cores: ${BOLD}${WHITE}${CPU_CORE_W} W${RESET}  └── Uncore: ${BOLD}${WHITE}${CPU_UNCORE_W} W${RESET} ${DIM}(System Agent, Ring & Cache)${RESET}"
    fi
    echo -e "  ${DIM}Power Limits    :${RESET} PL1: ${WHITE}${CPU_PL1_W}${RESET} (Sustained) | PL2: ${WHITE}${CPU_PL2_W}${RESET} (Turbo Peak)"
    echo -e "  ${DIM}Activity & Clock:${RESET} Load: ${BOLD}${WHITE}${CPU_USAGE_PCT}%${RESET} across ${CPU_THREADS} threads | Avg Freq: ${WHITE}${CPU_AVG_MHZ} MHz${RESET} (${CPU_GOVERNOR})"
    echo -e "  ${DIM}Thermals        :${RESET} Package: ${WHITE}${CPU_PKG_TEMP}${RESET} | Hottest Core: ${WHITE}${CPU_MAX_TEMP}${RESET}"
    echo ""

    # Section 3: GPU Subsystem
    echo -e "${BOLD}${GREEN}▶ DEDICATED GPU${RESET}  ${WHITE}${GPU_NAME}${RESET}"
    if [[ "$GPU_AVAILABLE" == true ]]; then
        echo -e "  ${BOLD}GPU Power Draw  :${RESET} ${BOLD}${GREEN}${GPU_POWER_W} W${RESET}  ${DIM}(Ceiling Limit: ${GPU_POWER_LIMIT_W} W | State: ${GPU_PSTATE})${RESET}"
        echo -e "  ${DIM}Utilization     :${RESET} Core: ${WHITE}${GPU_UTIL_PCT}%${RESET} | VRAM: ${WHITE}${GPU_VRAM_USED_MIB} / ${GPU_VRAM_TOTAL_MIB} MiB${RESET} (${GPU_MEM_UTIL_PCT}%)"
        echo -e "  ${DIM}Clocks & Thermals:${RESET} Core: ${WHITE}${GPU_GR_CLOCK_MHZ} MHz${RESET} | VRAM: ${WHITE}${GPU_MEM_CLOCK_MHZ} MHz${RESET} | Temp: ${WHITE}${GPU_TEMP_C}°C${RESET}"
    else
        echo -e "  ${DIM}Status          :${RESET} Discrete GPU not active or driver not initialized"
    fi
    echo ""

    # Section 4: Display, Fans & Peripherals
    echo -e "${BOLD}${YELLOW}▶ PERIPHERALS & CHASSIS SUBSYSTEMS${RESET}"
    echo -e "  ${DIM}Display Screen  :${RESET} ${BOLD}${WHITE}${DISP_POWER_W} W${RESET}  ${DIM}(Brightness: ${DISP_PCT}% [${DISP_BRIGHTNESS}/${DISP_MAX_BRIGHTNESS}])${RESET}"
    echo -e "  ${DIM}Cooling Fans    :${RESET} ${BOLD}${WHITE}${FAN_POWER_W} W${RESET}  ${DIM}(CPU Fan: ${FAN_CPU_RPM} RPM | GPU Fan: ${FAN_GPU_RPM} RPM)${RESET}"
    echo -e "  ${DIM}Platform Base   :${RESET} ${BOLD}${WHITE}${PERIPH_BASE_W} W${RESET}  ${DIM}(NVMe SSD: ${NVME_TEMP_C} | RAM: ${RAM_TEMP_C} | Wi-Fi: ${WIFI_TEMP_C} | Chipset)${RESET}"
    echo ""

    # Section 5: Power Distribution Visual Breakdown
    echo -e "${BOLD}${WHITE}▶ POWER BUDGET DISTRIBUTION${RESET}  ${DIM}(Sum: ${SUBSYSTEMS_SUM_W} W)${RESET}"
    print_power_bar() {
        local name="$1"
        local watts="$2"
        local total="$3"
        local col="$4"
        local pct
        pct=$(awk -v w="$watts" -v t="$total" 'BEGIN { if (t<=0) t=1; printf "%.1f", (w * 100.0) / t }')
        local bar
        bar=$(draw_bar "$watts" "$total" 20 "$col")
        printf "  %-10s %s  %b%5.2f W%b  (%5.1f%%)\n" "$name" "$bar" "$BOLD" "$watts" "$RESET" "$pct"
    }

    print_power_bar "CPU" "$CPU_PKG_W" "$SUBSYSTEMS_SUM_W" "$CYAN"
    print_power_bar "dGPU" "$GPU_POWER_W" "$SUBSYSTEMS_SUM_W" "$GREEN"
    print_power_bar "Display" "$DISP_POWER_W" "$SUBSYSTEMS_SUM_W" "$YELLOW"
    print_power_bar "Fans" "$FAN_POWER_W" "$SUBSYSTEMS_SUM_W" "$WHITE"
    print_power_bar "Platform" "$PERIPH_BASE_W" "$SUBSYSTEMS_SUM_W" "$MAGENTA"
    echo ""

    # Section 6: Top Power Consumers (Processes)
    echo -e "${BOLD}${CYAN}▶ TOP POWER-CONSUMING PROCESSES${RESET}"
    echo -e "  ${DIM}PID     USER       %CPU   %MEM   COMMAND${RESET}"
    ps -eo pid,user,%cpu,%mem,comm --sort=-%cpu 2>/dev/null | head -n 6 | tail -n 5 | while read -r p_pid p_user p_cpu p_mem p_comm; do
        printf "  %-7s %-10s %-6s %-6s %s\n" "$p_pid" "$p_user" "$p_cpu%" "$p_mem%" "$p_comm"
    done

    # Active GPU Processes
    if [[ "$GPU_AVAILABLE" == true ]]; then
        local gpu_procs
        gpu_procs=$(nvidia-smi | awk '/Processes:/ {flag=1; next} flag && /\|[ ]*[0-9]+/ {print $5, $7, $8, $6}')
        if [[ -n "$gpu_procs" ]]; then
            echo ""
            echo -e "  ${DIM}Active GPU Processes:${RESET}"
            while read -r g_pid g_name g_mem g_type; do
                echo -e "  PID ${WHITE}$g_pid${RESET} | ${g_name} | VRAM: ${WHITE}$g_mem${RESET} (${g_type})"
            done <<< "$gpu_procs"
        fi
    fi

    if [[ "$WATCH_MODE" == true ]]; then
        echo ""
        echo -e "${DIM}[Live monitoring every ${INTERVAL}s. Press 'q' or Ctrl+C to stop]${RESET}"
    fi
}

# --- Main Entry Point ---
if [[ "$OUTPUT_JSON" == true ]]; then
    output_json
elif [[ "$OUTPUT_WAYBAR" == true ]]; then
    output_waybar
elif [[ "$WATCH_MODE" == true ]]; then
    # Trap Ctrl+C cleanly
    trap 'echo -e "\nExiting power monitor."; exit 0' SIGINT SIGTERM
    while true; do
        render_dashboard
        read -r -t "$INTERVAL" -n 1 key 2>/dev/null || true
        if [[ "$key" == "q" || "$key" == "Q" ]]; then
            echo -e "\nExiting power monitor."
            break
        fi
    done
else
    render_dashboard
fi
