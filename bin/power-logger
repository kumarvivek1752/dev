#!/usr/bin/env python3
"""
power-logger: Continuous 24/7 Laptop Power & Energy Consumption Logger
Maintains a high-resolution time-series SQLite database of laptop power consumption.
Designed for low CPU overhead (<0.05% CPU), zero process forks, and high reliability.
"""

import os
import sys
import time
import signal
import sqlite3
import ctypes
from datetime import datetime

DB_DIR = os.path.expanduser("~/.local/share/power-usage")
DB_PATH = os.path.join(DB_DIR, "power.db")
SAMPLE_INTERVAL = 1.0  # 1 second
BATCH_SIZE = 5         # commit every 5 seconds to minimize SSD writes
RAW_RETENTION_DAYS = 30 # keep 1-second raw samples for 30 days, rollups kept forever

running = True

def handle_signal(sig, frame):
    global running
    running = False

signal.signal(signal.SIGTERM, handle_signal)
signal.signal(signal.SIGINT, handle_signal)

# ----------------- NVML Setup -----------------
class NVMLReader:
    def __init__(self):
        self.available = False
        self.handle = None
        self.nvml = None
        self.last_valid_pwr = 0.0
        try:
            self.nvml = ctypes.CDLL("libnvidia-ml.so.1")
            self.nvml.nvmlInit()
            self.handle = ctypes.c_void_p()
            self.nvml.nvmlDeviceGetHandleByIndex(0, ctypes.byref(self.handle))
            self.available = True
        except Exception:
            self.available = False

    def read(self):
        if not self.available:
            return 0.0, 0, 0
        try:
            pwr = ctypes.c_uint()
            self.nvml.nvmlDeviceGetPowerUsage(self.handle, ctypes.byref(pwr))
            w = pwr.value / 1000.0
            # Sanity check: RTX 4060 Mobile max ceiling is 140W.
            # Reject transient 590.01W driver glitch.
            if w > 140.0 or w < 0.0:
                w = self.last_valid_pwr
            else:
                self.last_valid_pwr = w

            temp = ctypes.c_uint()
            self.nvml.nvmlDeviceGetTemperature(self.handle, 0, ctypes.byref(temp))

            class nvmlUtilization_t(ctypes.Structure):
                _fields_ = [("gpu", ctypes.c_uint), ("memory", ctypes.c_uint)]
            util = nvmlUtilization_t()
            self.nvml.nvmlDeviceGetUtilizationRates(self.handle, ctypes.byref(util))
            return w, temp.value, util.gpu
        except Exception:
            return self.last_valid_pwr, 0, 0

# ----------------- Hardware Discovery -----------------
class HardwareReader:
    def __init__(self):
        self.nvml = NVMLReader()
        self.ac_path = None
        self.bat_path = None
        self.backlight_path = None
        self.max_backlight = 254
        self.rapl_pkg_path = None
        self.rapl_readable = False
        self.rapl_max_uj = 262143328850
        self.prev_rapl_uj = None
        self.prev_rapl_time = None
        self.prev_cpu_stat = None
        self.fan_cpu_path = None
        self.fan_gpu_path = None
        self.coretemp_path = None
        self.discover()

    def discover(self):
        for ac in ["/sys/class/power_supply/ACAD", "/sys/class/power_supply/AC"]:
            if os.path.exists(ac):
                self.ac_path = ac
                break

        for bat in ["/sys/class/power_supply/BAT1", "/sys/class/power_supply/BAT0"]:
            if os.path.exists(bat):
                self.bat_path = bat
                break

        for bl in ["/sys/class/backlight/nvidia_wmi_ec_backlight", "/sys/class/backlight/intel_backlight"]:
            if os.path.exists(bl):
                self.backlight_path = bl
                try:
                    with open(os.path.join(bl, "max_brightness")) as f:
                        self.max_backlight = max(1, int(f.read().strip()))
                except Exception:
                    self.max_backlight = 254
                break

        rapl_pkg = "/sys/class/powercap/intel-rapl:0"
        if os.path.exists(rapl_pkg):
            self.rapl_pkg_path = rapl_pkg
            try:
                with open(os.path.join(rapl_pkg, "max_energy_range_uj")) as f:
                    self.rapl_max_uj = int(f.read().strip())
            except Exception:
                pass
            if os.access(os.path.join(rapl_pkg, "energy_uj"), os.R_OK):
                self.rapl_readable = True

        # Hwmon scan
        hwmon_dir = "/sys/class/hwmon"
        if os.path.exists(hwmon_dir):
            for entry in os.listdir(hwmon_dir):
                hpath = os.path.join(hwmon_dir, entry)
                name_file = os.path.join(hpath, "name")
                if os.path.exists(name_file):
                    try:
                        with open(name_file) as f:
                            hname = f.read().strip()
                        if hname in ["acer", "acer-wmi"]:
                            self.fan_cpu_path = os.path.join(hpath, "fan1_input")
                            self.fan_gpu_path = os.path.join(hpath, "fan2_input")
                        elif hname in ["coretemp", "k10temp"]:
                            self.coretemp_path = os.path.join(hpath, "temp1_input")
                    except Exception:
                        pass

    def read_cpu_load(self):
        try:
            with open("/proc/stat") as f:
                line = f.readline()
            parts = [int(x) for x in line.split()[1:8]]
            total = sum(parts)
            idle = parts[3] + (parts[4] if len(parts) > 4 else 0)
            now = time.time()
            if self.prev_cpu_stat is None:
                self.prev_cpu_stat = (total, idle, now)
                return 0.0
            prev_total, prev_idle, prev_time = self.prev_cpu_stat
            self.prev_cpu_stat = (total, idle, now)
            dt_total = total - prev_total
            dt_idle = idle - prev_idle
            if dt_total > 0:
                return round(((dt_total - dt_idle) / dt_total) * 100.0, 1)
        except Exception:
            pass
        return 0.0

    def read_cpu_power(self, cpu_load):
        now = time.time()
        if self.rapl_readable and self.rapl_pkg_path:
            try:
                with open(os.path.join(self.rapl_pkg_path, "energy_uj")) as f:
                    uj = int(f.read().strip())
                if self.prev_rapl_uj is not None and self.prev_rapl_time is not None:
                    duj = uj - self.prev_rapl_uj
                    if duj < 0:
                        duj += self.rapl_max_uj
                    dt = now - self.prev_rapl_time
                    self.prev_rapl_uj = uj
                    self.prev_rapl_time = now
                    if dt > 0:
                        return round(duj / (dt * 1e6), 2)
                self.prev_rapl_uj = uj
                self.prev_rapl_time = now
            except Exception:
                pass

        # Fallback estimation
        avg_mhz = 1200.0
        try:
            with open("/proc/cpuinfo") as f:
                mhz_vals = [float(line.split(":")[1]) for line in f if "cpu MHz" in line]
            if mhz_vals:
                avg_mhz = sum(mhz_vals) / len(mhz_vals)
        except Exception:
            pass

        idle_w = 7.0
        active_tdp = 55.0
        ratio = max(0.5, min(2.5, avg_mhz / 2100.0))
        est = idle_w + (cpu_load / 100.0) * (active_tdp - idle_w) * ratio
        return round(est, 2)

    def sample(self):
        # 1. AC Online
        ac_online = 1
        if self.ac_path:
            try:
                with open(os.path.join(self.ac_path, "online")) as f:
                    ac_online = int(f.read().strip())
            except Exception:
                pass

        # 2. Battery
        bat_w = 0.0
        bat_pct = 100
        bat_status = "Full"
        if self.bat_path:
            try:
                with open(os.path.join(self.bat_path, "status")) as f:
                    bat_status = f.read().strip()
                with open(os.path.join(self.bat_path, "capacity")) as f:
                    bat_pct = int(f.read().strip())
                with open(os.path.join(self.bat_path, "voltage_now")) as f:
                    v_raw = int(f.read().strip())
                with open(os.path.join(self.bat_path, "current_now")) as f:
                    i_raw = int(f.read().strip())
                bat_w = round((v_raw * i_raw) / 1e12, 2)
            except Exception:
                pass

        # 3. CPU
        cpu_load = self.read_cpu_load()
        cpu_w = self.read_cpu_power(cpu_load)
        cpu_temp = 50.0
        if self.coretemp_path and os.path.exists(self.coretemp_path):
            try:
                with open(self.coretemp_path) as f:
                    cpu_temp = round(int(f.read().strip()) / 1000.0, 1)
            except Exception:
                pass

        # 4. GPU
        gpu_w, gpu_temp, gpu_util = self.nvml.read()

        # 5. Display
        disp_w = 1.68
        if self.backlight_path:
            try:
                with open(os.path.join(self.backlight_path, "brightness")) as f:
                    b = int(f.read().strip())
                disp_w = round(1.50 + ((b / self.max_backlight) * 4.50), 2)
            except Exception:
                pass

        # 6. Fans
        fan_w = 0.70
        if self.fan_cpu_path and os.path.exists(self.fan_cpu_path):
            try:
                with open(self.fan_cpu_path) as f:
                    f1 = int(f.read().strip())
                with open(self.fan_gpu_path) as f:
                    f2 = int(f.read().strip())
                fan_w = round(((f1 / 5000.0) ** 2) * 2.50 + ((f2 / 5000.0) ** 2) * 2.50, 2)
            except Exception:
                pass

        # 7. Platform Peripherals (NVMe, RAM, Wi-Fi, Motherboard Chipset)
        base_w = 6.40

        # Total System Consumption
        if bat_status == "Discharging" and bat_w > 0:
            total_w = bat_w
        else:
            total_w = round(cpu_w + gpu_w + disp_w + fan_w + base_w, 2)

        return {
            "timestamp": int(time.time()),
            "total_w": total_w,
            "cpu_w": cpu_w,
            "gpu_w": round(gpu_w, 2),
            "disp_w": disp_w,
            "fan_w": fan_w,
            "base_w": base_w,
            "bat_w": bat_w,
            "bat_pct": bat_pct,
            "ac_online": ac_online,
            "cpu_usage": cpu_load,
            "gpu_usage": float(gpu_util),
            "cpu_temp": cpu_temp,
            "gpu_temp": float(gpu_temp),
        }

# ----------------- Database Setup & Maintenance -----------------
def init_db():
    os.makedirs(DB_DIR, exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute("PRAGMA journal_mode = WAL;")
    cur.execute("PRAGMA synchronous = NORMAL;")

    cur.execute("""
    CREATE TABLE IF NOT EXISTS samples (
        timestamp INTEGER NOT NULL,
        total_w REAL NOT NULL,
        cpu_w REAL NOT NULL,
        gpu_w REAL NOT NULL,
        disp_w REAL NOT NULL,
        fan_w REAL NOT NULL,
        base_w REAL NOT NULL,
        bat_w REAL NOT NULL,
        bat_pct INTEGER NOT NULL,
        ac_online INTEGER NOT NULL,
        cpu_usage REAL NOT NULL,
        gpu_usage REAL NOT NULL,
        cpu_temp REAL NOT NULL,
        gpu_temp REAL NOT NULL
    );
    """)
    cur.execute("CREATE INDEX IF NOT EXISTS idx_samples_ts ON samples(timestamp);")

    cur.execute("""
    CREATE TABLE IF NOT EXISTS hourly_stats (
        hour_timestamp INTEGER PRIMARY KEY,
        sample_count INTEGER NOT NULL,
        avg_total_w REAL NOT NULL,
        min_total_w REAL NOT NULL,
        max_total_w REAL NOT NULL,
        energy_wh REAL NOT NULL,
        avg_cpu_w REAL NOT NULL,
        avg_gpu_w REAL NOT NULL,
        avg_disp_w REAL NOT NULL,
        bat_discharge_wh REAL NOT NULL,
        time_on_ac_sec INTEGER NOT NULL,
        time_on_bat_sec INTEGER NOT NULL
    );
    """)

    cur.execute("""
    CREATE TABLE IF NOT EXISTS daily_stats (
        date TEXT PRIMARY KEY,
        sample_count INTEGER NOT NULL,
        avg_total_w REAL NOT NULL,
        min_total_w REAL NOT NULL,
        max_total_w REAL NOT NULL,
        energy_kwh REAL NOT NULL,
        cpu_kwh REAL NOT NULL,
        gpu_kwh REAL NOT NULL,
        disp_kwh REAL NOT NULL,
        bat_discharge_kwh REAL NOT NULL,
        time_on_ac_sec INTEGER NOT NULL,
        time_on_bat_sec INTEGER NOT NULL
    );
    """)

    conn.commit()
    conn.close()

def perform_rollups(conn):
    """Aggregate raw samples into hourly and daily summary tables."""
    cur = conn.cursor()
    now_ts = int(time.time())
    current_hour_start = now_ts - (now_ts % 3600)

    # Find earliest completed hour in samples not in hourly_stats
    cur.execute("""
        SELECT DISTINCT (timestamp - (timestamp % 3600)) as hr
        FROM samples
        WHERE timestamp < ? AND (timestamp - (timestamp % 3600)) NOT IN (SELECT hour_timestamp FROM hourly_stats)
        ORDER BY hr ASC
    """, (current_hour_start,))
    missing_hours = [r[0] for r in cur.fetchall()]

    for hr in missing_hours:
        hr_end = hr + 3600
        cur.execute("""
            SELECT 
                COUNT(*),
                AVG(total_w),
                MIN(total_w),
                MAX(total_w),
                SUM(total_w) / 3600.0,
                AVG(cpu_w),
                AVG(gpu_w),
                AVG(disp_w),
                SUM(CASE WHEN ac_online = 0 THEN bat_w ELSE 0 END) / 3600.0,
                SUM(CASE WHEN ac_online = 1 THEN 1 ELSE 0 END),
                SUM(CASE WHEN ac_online = 0 THEN 1 ELSE 0 END)
            FROM samples
            WHERE timestamp >= ? AND timestamp < ?
        """, (hr, hr_end))
        row = cur.fetchone()
        if row and row[0] and row[0] > 0:
            cur.execute("""
                INSERT OR REPLACE INTO hourly_stats (
                    hour_timestamp, sample_count, avg_total_w, min_total_w, max_total_w,
                    energy_wh, avg_cpu_w, avg_gpu_w, avg_disp_w, bat_discharge_wh,
                    time_on_ac_sec, time_on_bat_sec
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, (hr, row[0], round(row[1], 2), round(row[2], 2), round(row[3], 2),
                  round(row[4], 3), round(row[5], 2), round(row[6], 2), round(row[7], 2),
                  round(row[8], 3), int(row[9]), int(row[10])))

    # Find completed dates not in daily_stats
    today_str = datetime.now().strftime("%Y-%m-%d")
    cur.execute("""
        SELECT DISTINCT strftime('%Y-%m-%d', datetime(hour_timestamp, 'unixepoch', 'localtime')) as dt
        FROM hourly_stats
        WHERE dt != ? AND dt NOT IN (SELECT date FROM daily_stats)
    """, (today_str,))
    missing_days = [r[0] for r in cur.fetchall()]

    for dt in missing_days:
        cur.execute("""
            SELECT 
                SUM(sample_count),
                AVG(avg_total_w),
                MIN(min_total_w),
                MAX(max_total_w),
                SUM(energy_wh) / 1000.0,
                SUM(avg_cpu_w * sample_count) / 3600000.0,
                SUM(avg_gpu_w * sample_count) / 3600000.0,
                SUM(avg_disp_w * sample_count) / 3600000.0,
                SUM(bat_discharge_wh) / 1000.0,
                SUM(time_on_ac_sec),
                SUM(time_on_bat_sec)
            FROM hourly_stats
            WHERE strftime('%Y-%m-%d', datetime(hour_timestamp, 'unixepoch', 'localtime')) = ?
        """, (dt,))
        drow = cur.fetchone()
        if drow and drow[0] and drow[0] > 0:
            cur.execute("""
                INSERT OR REPLACE INTO daily_stats (
                    date, sample_count, avg_total_w, min_total_w, max_total_w,
                    energy_kwh, cpu_kwh, gpu_kwh, disp_kwh, bat_discharge_kwh,
                    time_on_ac_sec, time_on_bat_sec
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, (dt, drow[0], round(drow[1], 2), round(drow[2], 2), round(drow[3], 2),
                  round(drow[4], 4), round(drow[5], 4), round(drow[6], 4), round(drow[7], 4),
                  round(drow[8], 4), int(drow[9]), int(drow[10])))

    # Prune raw samples older than RAW_RETENTION_DAYS (30 days)
    cutoff = now_ts - (RAW_RETENTION_DAYS * 86400)
    cur.execute("DELETE FROM samples WHERE timestamp < ?;", (cutoff,))
    conn.commit()

# ----------------- Main Logger Loop -----------------
def main():
    print(f"[power-logger] Starting power logging daemon... DB: {DB_PATH}")
    init_db()
    hw = HardwareReader()

    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()

    buffer = []
    last_rollup_check = time.time()
    last_loop_time = time.time()

    # Initial rollup check
    try:
        perform_rollups(conn)
    except Exception as e:
        print(f"[power-logger] Initial rollup error: {e}", file=sys.stderr)

    while running:
        loop_start = time.time()

        # Handle system sleep / suspend gap
        if loop_start - last_loop_time > 5.0:
            # Woke from sleep / suspend
            hw.discover()  # rediscover device nodes in case hwmon numbers changed

        last_loop_time = loop_start

        try:
            sample = hw.sample()
            buffer.append((
                sample["timestamp"], sample["total_w"], sample["cpu_w"], sample["gpu_w"],
                sample["disp_w"], sample["fan_w"], sample["base_w"], sample["bat_w"],
                sample["bat_pct"], sample["ac_online"], sample["cpu_usage"], sample["gpu_usage"],
                sample["cpu_temp"], sample["gpu_temp"]
            ))
        except Exception as e:
            print(f"[power-logger] Sample error: {e}", file=sys.stderr)

        if len(buffer) >= BATCH_SIZE:
            try:
                cur.executemany("""
                    INSERT INTO samples (
                        timestamp, total_w, cpu_w, gpu_w, disp_w, fan_w, base_w,
                        bat_w, bat_pct, ac_online, cpu_usage, gpu_usage, cpu_temp, gpu_temp
                    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                """, buffer)
                conn.commit()
                buffer.clear()
            except Exception as e:
                print(f"[power-logger] DB commit error: {e}", file=sys.stderr)

        # Rollup check every 10 minutes
        if time.time() - last_rollup_check > 600:
            last_rollup_check = time.time()
            try:
                perform_rollups(conn)
            except Exception as e:
                print(f"[power-logger] Rollup error: {e}", file=sys.stderr)

        elapsed = time.time() - loop_start
        sleep_dur = max(0.05, SAMPLE_INTERVAL - elapsed)
        time.sleep(sleep_dur)

    # Flush remaining buffer on shutdown
    if buffer:
        try:
            cur.executemany("""
                INSERT INTO samples (
                    timestamp, total_w, cpu_w, gpu_w, disp_w, fan_w, base_w,
                    bat_w, bat_pct, ac_online, cpu_usage, gpu_usage, cpu_temp, gpu_temp
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, buffer)
            conn.commit()
        except Exception:
            pass

    conn.close()
    print("[power-logger] Daemon stopped cleanly.")

if __name__ == "__main__":
    main()
